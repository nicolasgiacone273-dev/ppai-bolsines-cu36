@startuml 02-secuencia-cu36
title CU 36 Consultar seguimiento de bolsines - Vista dinámica de diseño con el patrón Adapter\nFlujo básico (GPS Tracker modelo XTR-4500L; incluye al CU 30 Notificar ubicación de bolsín)

hide footbox
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam maxMessageSize 320
skinparam sequence {
  ArrowColor #17243B
  LifeLineBorderColor #4A5870
  ParticipantBorderColor #17243B
  ParticipantBackgroundColor #FFFFFF
}
skinparam note {
  BackgroundColor #FFF7DC
  BorderColor #E8B10A
}

' Los objetos en color naranja representan a todos los objetos de la clase
' (o a un subconjunto); los blancos, a una única instancia.
actor ":Encargado\nde Bolsines" as EB
boundary ":PantallaConsultar\nSeguimientoBolsines" as P
boundary ":InterfazMapa" as M
control ":GestorConsultar\nSeguimientoBolsines" as G
control ":SesionUsuario" as S
entity "logueado:\nEmpleado" as E
entity "cmUsuario:\nComisionMedica" as CMU
entity "rolUsuario:\nRol" as RU
participant ":BolsinRepository" as BR
entity ":Bolsin" as B #F6C28B
entity "seleccionado:\nBolsin" as BS
entity ":ComisionMedica" as CM #F6C28B
entity "destino:\nComisionMedica" as DEST
entity ":CambioEstado\nBolsin" as CE #F6C28B
entity ":Estado" as ES #F6C28B
entity ":GPSTracker" as GT #F6C28B
participant ":AdaptadorGPSTracker\nXTR4500L" as A
participant ":ServicioGPSTracker\nXTR4500L" as SV
participant ":UbicacionBolsin" as U #F6C28B
participant "ubicacion:\nUbicacionBolsin" as UB
participant ":EmpleadoRepository" as ER
entity ":Empleado" as EMP #F6C28B
entity ":Rol" as R #F6C28B
control ":GestorNotificar\nUbicacionBolsin" as GN
boundary ":InterfazCorreo\nElectronico" as IC

== Paso 1: el EB selecciona la opción ==
EB -> P : opcionConsultarSeguimientoBolsines() : ResponseEntity<?>
activate P
note right of P
  Al abrirse la pantalla, habilitarPantalla() crea la
  InterfazMapa y dispara esta opción.
end note
P -> P : ejecutar(accion : Supplier<Object>) : ResponseEntity<?>
activate P
P -> S : estaIniciada() : boolean
P -> S : esEncargadoDeBolsines() : boolean
activate S
S -> E : sosEncargadoDeBolsines() : boolean
E -> RU : esEncargadoDeBolsines() : boolean
deactivate S
P -> G : opcionConsultarSeguimiento() : ResultadoSeguimientoDTO
activate G
G -> G : limpiarEjecucion() : void

== Paso 2: CM del usuario logueado ==
G -> G : buscarCMUsuarioLogueado() : void
activate G
G -> S : obtenerEmpleadoLogueado() : Empleado
G -> E : getCM() : ComisionMedica
deactivate G

== Paso 3: bolsines Enviados cuya CM origen es la del usuario ==
G -> G : buscarBolsinesEnviados() : void
activate G
G -> BR : findAll() : List<Bolsin>
loop mientras haya bolsines
  G -> B : esTuCMOrigen(comisionMedica : ComisionMedica) : boolean
  B -> CM : esLaMisma(otra : ComisionMedica) : boolean
  CM -> CMU : getCodigo() : String
  opt el bolsín es de la CM del usuario
    G -> B : sosEnviado() : boolean
    loop mientras haya cambios de estado y no se encuentre el actual
      B -> CE : sosActual() : boolean
      opt es el cambio de estado actual
        B -> CE : sosEnviado() : boolean
        CE -> ES : esEnviado() : boolean
        ES -> ES : esAmbitoBolsin() : boolean
      end
    end
  end
end
G -> B : ~*getNumeroBolsin() : Integer
note right of G
  Ordena los bolsines enviados por número.
end note
deactivate G

== Pasos 4 y 5: se solicita la ubicación al GPS Tracker de cada bolsín (Adapter) ==
G -> G : solicitarUbicacionesAlGPSTracker() : void
activate G
loop mientras haya bolsines enviados
  G -> B : conocerModeloGPSTracker() : String
  B -> GT : getModelo() : String
  G -> G : obtenerAdaptador(modelo : String) : IAdaptadorGPSTracker
  note right of G
    El gestor sólo conoce la interfaz
    IAdaptadorGPSTracker. Para el modelo
    XTR-4500L obtiene este adaptador.
  end note
  G -> B : getNumeroBolsin() : Integer
  G -> B : obtenerCodigoCMOrigen() : String
  B -> CM : getCodigo() : String
  G -> B : obtenerCodigoCMDestino() : String
  B -> CM : getCodigo() : String
  G -> A : obtenerUbicacion(numeroBolsin : int, codigoCMOrigen : String, codigoCMDestino : String) : UbicacionBolsin
  activate A
  A -> SV : getBolsinLocation(apiKey : String, numeroBolsin : int, codigoComisionMedicaOrigen : String) : String
  note right of SV
    El servicio es el Adaptable: representa al endpoint
    getBolsinLocation() del GPS Tracker XTR-4500L
    (actor secundario). Devuelve un JSON en String:
    {"items":[{numeroBolsin, latitud,
    longitud, fechaHoraUltimaActualizacion}]}
  end note
  A -> A : interpretarJson(json : String, numeroBolsin : int) : UbicacionBolsin
  activate A
  create U
  A --> U : new(numeroBolsin : int, latitud : double, longitud : double, fechaHoraUltimaActualizacion : LocalDateTime)
  deactivate A
  deactivate A
  G -> B : getNumeroBolsin() : Integer
end
deactivate G

== Paso 6: se muestran los bolsines en el mapa ==
G -> G : mensajeSinUbicacion() : String
G -> G : tipoMensajeSinUbicacion() : String
G -> G : armarResultado(bolsines : List<Bolsin>, mensaje : String, tipoMensaje : String) : ResultadoSeguimientoDTO
activate G
loop mientras haya bolsines
  G -> B : getNumeroBolsin() : Integer
  G -> B : getNroPrecinto() : Integer
  G -> B : obtenerCodigoCMDestino() : String
  B -> CM : getCodigo() : String
  G -> B : obtenerCMDestino() : ComisionMedica
  G -> CM : getNombre() : String
  G -> B : conocerModeloGPSTracker() : String
  B -> GT : getModelo() : String
  G -> U : getLatitud() : double
  G -> U : getLongitud() : double
  G -> U : getFechaHoraUltimaActualizacion() : LocalDateTime
end
G -> CMU : getCodigo() : String
G -> CMU : getNombre() : String
G -> G : armarOpcionesCMDestino() : List<OpcionCMDTO>
activate G
loop mientras haya bolsines enviados
  G -> B : obtenerCMDestino() : ComisionMedica
  G -> CM : getCodigo() : String
  G -> CM : getNombre() : String
end
deactivate G
deactivate G
deactivate G
deactivate P
P -> P : mostrarResultado(resultado : ResultadoSeguimientoDTO, esConsultaInicial : boolean) : void
activate P
P -> P : mostrarCMUsuario(resultado : ResultadoSeguimientoDTO) : void
P -> P : cargarOpcionesCMDestino(cms : List<OpcionCMDTO>) : void
P -> P : mostrarResumen(resultado : ResultadoSeguimientoDTO) : void
P -> P : mostrarBolsinesEnLista(ubicados : List<BolsinUbicadoDTO>, sinUbicacion : List<BolsinSinUbicacionDTO>) : void
P -> P : mostrarBolsinesEnMapa(bolsines : List<BolsinUbicadoDTO>) : void
activate P
P -> M : mostrarBolsines(bolsines : List<BolsinUbicadoDTO>, alSeleccionar : Function) : void
note right of M
  InterfazMapa representa al Servidor Google Maps
  (actor secundario): dibuja el mapa y un marcador
  por cada bolsín.
end note
deactivate P
P -> P : mostrarMensaje(texto : String, tipo : String) : void
deactivate P
deactivate P

== Paso 7: el EB selecciona un bolsín del mapa ==
EB -> P : tomarSeleccionBolsin(numeroBolsin : int) : ResponseEntity<?>
activate P
P -> P : ejecutar(accion : Supplier<Object>) : ResponseEntity<?>
activate P
P -> S : estaIniciada() : boolean
P -> S : esEncargadoDeBolsines() : boolean
activate S
S -> E : sosEncargadoDeBolsines() : boolean
E -> RU : esEncargadoDeBolsines() : boolean
deactivate S
P -> G : tomarSeleccionBolsin(numeroBolsin : int) : ConsultaEnvioCorreoDTO
activate G
G -> G : verificarConsultaIniciada() : void
G -> G : buscarBolsinEnviado(numeroBolsin : int) : Bolsin
activate G
G -> B : ~*getNumeroBolsin() : Integer
deactivate G
G -> BS : obtenerCMDestino() : ComisionMedica
G -> DEST : getNombre() : String
G -> BS : getNroPrecinto() : Integer
G -> UB : getFechaHoraUltimaActualizacion() : LocalDateTime
G -> UB : getLatitud() : double
G -> UB : getLongitud() : double
deactivate G
deactivate P
P -> P : marcarSeleccion(numero : int) : void
activate P
P -> M : resaltar(numero : int) : void
deactivate P

== Paso 8: se consulta si se desea enviar el correo ==
P -> P : solicitarConfirmacionEnvioCorreo(consulta : ConsultaEnvioCorreoDTO) : void
deactivate P

== Paso 9: el EB confirma el envío ==
EB -> P : tomarConfirmacionEnvioCorreo(confirma : boolean) : ResponseEntity<?>
activate P
P -> P : ejecutar(accion : Supplier<Object>) : ResponseEntity<?>
activate P
P -> S : estaIniciada() : boolean
P -> S : esEncargadoDeBolsines() : boolean
activate S
S -> E : sosEncargadoDeBolsines() : boolean
E -> RU : esEncargadoDeBolsines() : boolean
deactivate S
P -> G : tomarConfirmacionEnvioCorreo(confirma : boolean) : ResultadoNotificacionDTO
activate G
G -> G : verificarConsultaIniciada() : void

== Paso 10: se busca el correo del Gerente de la CM destino ==
G -> G : buscarEmailGCMDestino() : String
activate G
G -> BS : obtenerCMDestino() : ComisionMedica
G -> ER : findAll() : List<Empleado>
loop mientras haya empleados y no se encuentre el GCM
  G -> EMP : esTuCM(comisionMedica : ComisionMedica) : boolean
  EMP -> CM : esLaMisma(otra : ComisionMedica) : boolean
  CM -> DEST : getCodigo() : String
  opt el empleado es de la CM destino
    G -> EMP : sosGCM() : boolean
    EMP -> R : esGCM() : boolean
    opt el empleado es GCM
      G -> EMP : getEmail() : String
    end
  end
end
deactivate G

== Paso 11: se incluye al CU 30 Notificar ubicación de bolsín ==
G -> BS : obtenerCMDestino() : ComisionMedica
G -> BS : getNumeroBolsin() : Integer
G -> DEST : getNombre() : String
G -> UB : getNumeroBolsin() : int
G -> UB : getFechaHoraUltimaActualizacion() : LocalDateTime
G -> UB : getLatitud() : double
G -> UB : getLongitud() : double
G -> GN : notificarUbicacionBolsin(emailDestinatario : String, nombreCMDestino : String, numeroBolsin : int, fechaHoraUltimaActualizacion : LocalDateTime, latitud : double, longitud : double) : String
activate GN
GN -> IC : enviarCorreo(destinatario : String, asunto : String, cuerpo : String) : String
activate IC
IC -> IC : codificarAsunto(asunto : String) : String
note right of IC
  InterfazCorreoElectronico representa al
  Servidor de Correo (actor secundario): es la
  que entrega el correo al Gerente de la CM destino.
end note
deactivate IC
deactivate GN
G -> UB : getNumeroBolsin() : int
G -> DEST : getNombre() : String
G -> G : finCU() : void
activate G
G -> G : limpiarEjecucion() : void
deactivate G
deactivate G
deactivate P
P -> P : informarEnvioExitoso(resultado : ResultadoNotificacionDTO) : void
deactivate P
@enduml
